{
    "name": "monkeyscloud/monkeyslegion",
    "description": "High-performance PHP 8.4 framework — attribute-first architecture, property hooks, compiled DI, MLC configuration.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "monkeyscloud/monkeyslegion-apex": "^1.1",
        "monkeyscloud/monkeyslegion-auth": "^2.2",
        "monkeyscloud/monkeyslegion-cache": "^2.0",
        "monkeyscloud/monkeyslegion-cli": "^2.1",
        "monkeyscloud/monkeyslegion-contracts": "^2.0",
        "monkeyscloud/monkeyslegion-core": "^2.1",
        "monkeyscloud/monkeyslegion-database": "^2.2",
        "monkeyscloud/monkeyslegion-dev-server": "^1.0",
        "monkeyscloud/monkeyslegion-devtools": "^2.1",
        "monkeyscloud/monkeyslegion-di": "^2.0",
        "monkeyscloud/monkeyslegion-entity": "^2.1",
        "monkeyscloud/monkeyslegion-events": "^2.0",
        "monkeyscloud/monkeyslegion-feature-flags": "^1.0",
        "monkeyscloud/monkeyslegion-files": "^2.0",
        "monkeyscloud/monkeyslegion-http": "^2.1",
        "monkeyscloud/monkeyslegion-i18n": "^2.1",
        "monkeyscloud/monkeyslegion-inertia": "^1.0",
        "monkeyscloud/monkeyslegion-logger": "^2.0",
        "monkeyscloud/monkeyslegion-mail": "^2.0",
        "monkeyscloud/monkeyslegion-markdown": "^1.0",
        "monkeyscloud/monkeyslegion-migration": "^2.0",
        "monkeyscloud/monkeyslegion-mlc": "^3.2",
        "monkeyscloud/monkeyslegion-notifications": "^1.1",
        "monkeyscloud/monkeyslegion-openapi": "^1.1",
        "monkeyscloud/monkeyslegion-query": "^2.1",
        "monkeyscloud/monkeyslegion-queue": "^2.0",
        "monkeyscloud/monkeyslegion-router": "^2.2",
        "monkeyscloud/monkeyslegion-schedule": "^1.2",
        "monkeyscloud/monkeyslegion-search": "^1.1",
        "monkeyscloud/monkeyslegion-session": "^2.0",
        "monkeyscloud/monkeyslegion-sockets": "^1.2",
        "monkeyscloud/monkeyslegion-telemetry": "^2.1",
        "monkeyscloud/monkeyslegion-template": "^2.0",
        "monkeyscloud/monkeyslegion-validation": "^2.1",
        "monkeyscloud/monkeyslegion-vite": "^1.0",
        "monkeyscloud/monkeyslegion-webhooks": "^1.0",
        "php": "^8.4"
    },
    "require-dev": {
        "monkeyscloud/monkeyslegion-testing": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\": "src/"
        },
        "files": [
            "bootstrap/env.php",
            "src/stubs/redis.php"
        ],
        "exclude-from-classmap": [
            "src/stubs/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeysLegion\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.1.x-dev"
        },
        "monkeyslegion": {
            "providers": [
                "MonkeysLegion\\Config\\AppConfig"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --level=9 src/",
        "lint": "find src/ -name '*.php' -exec php -l {} \\;"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
